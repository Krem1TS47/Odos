{
  "name": "odos",
  "version": "2.0.0",
  "description": "Local-first browser extension for prefilling and logging job applications",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "node scripts/build.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check-budget": "node scripts/check-budget.js",
    "benchmark": "vitest run tests/unit/benchmark.test.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-separator": "^1.2.0",
